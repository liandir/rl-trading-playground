.venv/
venv/
env/

# Python packaging/build artifacts
*.egg-info/
build/
dist/

# Test/type/lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# uv cache, when configured inside the project
.uv-cache/

# Generated documentation output (markdown sources in docs/ stay tracked)
docs/*.html
docs/api/
docs/.nojekyll
