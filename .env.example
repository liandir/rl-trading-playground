# News collector — copy to .env (or export in your shell) and fill in.

# CryptoPanic — https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# NewsAPI.org — https://newsapi.org/
NEWSAPI_KEY=

# Reddit (script app) — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=news-collector/0.1 by your-username

# X / Twitter — pick a backend before filling these
TWITTER_BEARER_TOKEN=
LUNARCRUSH_API_KEY=
